{
  "name": "@46ki75/internal-web",
  "description": "SolidStart frontend for internal.46ki75.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "engines-annotation": "SolidStart v2 requires Node.js 24 or newer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-theme-css.mjs .output/public",
    "build-storybook": "storybook build && node scripts/verify-theme-css.mjs storybook-static",
    "build:types": "tsc --incremental --noEmit",
    "deploy": "./scripts/deploy-s3.sh",
    "deploy:dev": "VITE_STAGE_NAME=dev pnpm run deploy",
    "deploy:stg": "VITE_STAGE_NAME=stg pnpm run deploy",
    "deploy:prod": "VITE_STAGE_NAME=prod pnpm run deploy",
    "dev": "VITE_STAGE_NAME=dev vite dev",
    "dev:debug": "VITE_STAGE_NAME=dev node --inspect-brk ./node_modules/vite/bin/vite.js dev",
    "fmt": "prettier --write ./src",
    "fmt:check": "prettier --check ./src",
    "generate:openapi": "bash -o pipefail -c 'cargo run --locked --quiet -p http-api --example export_openapi | openapi-typescript -o src/openapi/schema.ts'",
    "lint": "eslint \"{src,.storybook}/**/*.{ts,tsx}\"",
    "lint:css": "stylelint \"{src,.storybook}/**/*.css\"",
    "postdeploy": "./scripts/invalidate.sh",
    "predeploy": "pnpm run build",
    "preview": "vite preview",
    "start": "vite dev --open",
    "storybook": "storybook dev -p 11071 --no-open",
    "test": "vitest run",
    "check": "concurrently -g \"pnpm:lint\" \"pnpm:lint:css\" \"pnpm:build:types\" \"pnpm:test\" \"pnpm:fmt:check\""
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@elmethis/core": "^0.24.0",
    "@elmethis/solid": "^0.7.2",
    "@formkit/auto-animate": "^0.10.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@mdi/js": "^7.4.47",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "@tanstack/query-sync-storage-persister": "5.104.1",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "5.104.1",
    "@tanstack/solid-query-persist-client": "5.104.1",
    "@tanstack/solid-table": "^9.2.6",
    "aws-amplify": "^6.22.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "fuse.js": "^7.5.0",
    "nitro": "3.0.260610-beta",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "17.13.0",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "storybook": "^10.6.1",
    "storybook-solidjs-vite": "^10.7.2",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "typescript-plugin-css-modules": "latest",
    "vite": "8.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^5.0.1"
  }
}
