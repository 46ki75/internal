{
  "name": "@46ki75/internal-web",
  "description": "SolidStart frontend for internal.46ki75.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "engines-annotation": "SolidStart v2 requires Node.js 24 or newer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "./scripts/deploy-s3.sh",
    "deploy.dev": "VITE_STAGE_NAME=dev pnpm run deploy",
    "deploy.stg": "VITE_STAGE_NAME=stg pnpm run deploy",
    "deploy.prod": "VITE_STAGE_NAME=prod pnpm run deploy",
    "dev": "VITE_STAGE_NAME=dev vite dev",
    "dev.debug": "VITE_STAGE_NAME=dev node --inspect-brk ./node_modules/vite/bin/vite.js dev",
    "fmt": "prettier --write ./src",
    "fmt.check": "prettier --check ./src",
    "generate:openapi": "openapi-typescript http://localhost:9000/lambda-url/http-api/api-gateway/api/v1/openapi.json -o src/openapi/schema.ts",
    "lint": "eslint \"{src,.storybook}/**/*.{ts,tsx}\"",
    "lint.css": "stylelint \"{src,.storybook}/**/*.css\"",
    "postdeploy": "./scripts/invalidate.sh",
    "predeploy": "pnpm run build",
    "preview": "vite preview",
    "start": "vite dev --open",
    "storybook": "storybook dev -p 11071 --no-open",
    "test": "vitest run",
    "check": "concurrently -g \"pnpm:lint\" \"pnpm:build.types\" \"pnpm:test\" \"pnpm:fmt.check\""
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@elmethis/core": "^0.24.0",
    "@elmethis/solid": "^0.7.1",
    "@formkit/auto-animate": "^0.10.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@mdi/js": "^7.4.47",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.4",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/solid-form": "^1.33.2",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-query-persist-client": "^5.101.4",
    "@tanstack/solid-table": "^8.21.3",
    "aws-amplify": "^6.16.2",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.46.1",
    "fuse.js": "^7.1.0",
    "nitro": "3.0.260610-beta",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.3",
    "@vitest/eslint-plugin": "^1.6.24",
    "concurrently": "^10.0.4",
    "eslint": "9.32.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "16.4.0",
    "happy-dom": "^20.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "storybook": "^10.5.10",
    "storybook-solidjs-vite": "^10.7.2",
    "stylelint": "^17.14.1",
    "typescript": "5.8",
    "typescript-eslint": "8.70.0",
    "typescript-plugin-css-modules": "latest",
    "vite": "8.2.2",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^5.0.0"
  }
}
